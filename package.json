{
    "name": "nexuscode",
    "version": "0.1.0",
    "private": true,
    "description": "NexusCode — AI coding agent combining best practices from all vibe-coding tools",
    "packageManager": "pnpm@10.8.1",
    "engines": {
        "node": "24.18.0",
        "pnpm": "10.8.1"
    },
    "workspaces": [
        "packages/*",
        "packages/vscode/webview-ui"
    ],
    "scripts": {
        "preinstall": "node scripts/check-node.js",
        "build": "corepack pnpm -r --workspace-concurrency=2 --stream build",
        "build:context-mode": "node scripts/build-optional-context-mode.mjs",
        "build:core": "corepack pnpm --filter @nexuscode/core build",
        "build:vscode": "corepack pnpm --filter nexuscode build",
        "build:cli": "corepack pnpm --filter @nexuscode/cli build",
        "package:vscode": "corepack pnpm build && corepack pnpm --filter nexuscode package",
        "dev:core": "corepack pnpm --filter @nexuscode/core dev",
        "dev:cli": "corepack pnpm --filter @nexuscode/cli dev",
        "typecheck": "corepack pnpm -r --workspace-concurrency=1 --stream typecheck",
        "test": "corepack pnpm -r --workspace-concurrency=1 --stream test",
        "test:core": "corepack pnpm --filter @nexuscode/core test",
        "test:runtime": "node --test scripts/runtime-version.test.mjs scripts/one-install.test.mjs scripts/build-optional-context-mode.test.mjs scripts/storage-portability.test.mjs scripts/feature-census.test.mjs",
        "census:features": "node scripts/feature-census.mjs",
        "census:features:check": "node scripts/feature-census.mjs --check",
        "validate:mcp-skills": "corepack pnpm run build:core && node scripts/validate-mcp-skills-workflow.mjs",
        "clean": "corepack pnpm -r --stream clean && rm -rf node_modules",
        "build:server": "corepack pnpm --filter @nexuscode/server build",
        "serve": "node scripts/check-node.js && node packages/server/dist/cli.js",
        "setup": "corepack pnpm install && corepack pnpm build",
        "one": "node scripts/one-install.js",
        "install:local": "node scripts/one-install.js",
        "fullbuild": "corepack pnpm run setup && corepack pnpm --filter nexuscode package",
        "ready": "node scripts/one-install.js",
        "nexus": "node packages/cli/dist/index.js",
        "cli": "sh scripts/install-nexus-cli.sh",
        "install-cli": "pnpm run cli",
        "extension": "sh scripts/install-nexus-vscode.sh",
        "install-vscode": "pnpm run extension"
    },
    "devDependencies": {
        "typescript": "^5.5.0",
        "tsup": "^8.3.0"
    }
}
