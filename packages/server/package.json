{
  "name": "@nexuscode/server",
  "version": "0.1.0",
  "private": true,
  "description": "NexusCode session server — CLI and extension connect via HTTP/SSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "corepack pnpm --filter @nexuscode/sandbox build && node ../sandbox/scripts/copy-native.mjs . && tsup src/index.ts src/cli.ts --format esm --dts --target node24 --outDir dist",
    "dev": "tsup src/index.ts --format esm --dts --target node24 --outDir dist --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexuscode/core": "workspace:*",
    "@nexuscode/sandbox": "workspace:*",
    "@nexuscode/state": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "execa": "^9.5.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "3.2.3"
  },
  "bin": {
    "nexus-serve": "./dist/cli.js"
  }
}
