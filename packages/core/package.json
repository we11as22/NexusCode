    "@ai-sdk/openai": "^1.2.0",
    "@ai-sdk/openai-compatible": "^0.2.16",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@openrouter/ai-sdk-provider": "^0.7.5",
    "@qdrant/js-client-rest": "^1.13.0",
    "ai": "^4.3.0",
    "diff": "^7.0.0",
    "esbuild-wasm": "0.25.12",
    "execa": "^9.5.0",
    "glob": "^11.0.0",
    "hash-object": "^5.0.1",
    "ignore": "^6.0.2",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.1",
