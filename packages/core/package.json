    "@types/diff": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.24.0",
    "react": "18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "3.2.3"
  }
